# ===== AMBIENTE =====
NODE_ENV=development

# ===== BASE DE DATOS =====
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=tu_password_aqui
DB_NAME=database_sircof

# ===== BACKEND (Express) =====
PORT=3000
BACKEND_URL=http://localhost:3000

# ===== FRONTEND =====
# URL que usa el cliente para conectarse al backend
VITE_API_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ===== URLS PÚBLICAS (Para callbacks y emails) =====
# URL base pública del servidor (usado en redirects, emails, etc)
PUBLIC_URL=http://localhost:3000
CALLBACK_URL=http://localhost:3000/checkout/success

# ===== GOOGLE OAUTH =====
GOOGLE_CLIENT_ID=tu_google_client_id
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ===== PAYPAL =====
PAYPAL_CLIENT_ID=tu_paypal_client_id
PAYPAL_CLIENT_SECRET=tu_paypal_secret
PAYPAL_MODE=sandbox

# ===== TILOPAY =====
TILOPAY_API_KEY=tu_tilopay_key
TILOPAY_API_USER=tu_tilopay_user
TILOPAY_API_PASSWORD=tu_tilopay_password
TILOPAY_ENVIRONMENT=sandbox
WEBHOOK_URL=tu_webhook_url

# ===== JWT =====
JWT_SECRET=tu_jwt_secret_key_largo_y_aleatorio

# ===== EMAIL (opcional) =====
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=
COMPANY_EMAIL=
COMPANY_NAME=

# ===== NOTAS DE CONFIGURACIÓN =====
# 
#EN DESARROLLO (localhost):
#   NODE_ENV=development
#   VITE_API_URL=http://localhost:3000
#   PUBLIC_URL=http://localhost:3000
#   CORS_ORIGIN=http://localhost:3000
#   GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
#   CALLBACK_URL=http://localhost:3000/checkout/success
#
# EN PRODUCCIÓN (tu host público):
#   NODE_ENV=production
#   VITE_API_URL=https://tu-dominio.com
#   PUBLIC_URL=https://tu-dominio.com
#   CORS_ORIGIN=https://tu-dominio.com
#   GOOGLE_REDIRECT_URI=https://tu-dominio.com/auth/google/callback
#   CALLBACK_URL=https://tu-dominio.com/checkout/success
#
# IMPORTANTE:
#   - Todas las URLs deben coincidir con el dominio actual
#   - Google OAuth necesita redirect URIs registrados en Google Cloud
#   - En HTTPS (producción) es OBLIGATORIO
#   - NODE_ENV=production activa Secure flag en cookies

